# Copy to .env, then replace placeholders with your OWN credentials.
# Never commit .env or share real keys.
TAVILY_API_KEY=replace_with_your_tavily_api_key
GROQ_API_KEY=replace_with_your_groq_api_key
ARGUS_MODEL=openai/gpt-oss-120b
# ARGUS_BASE_URL=https://api.groq.com/openai/v1

# Optional: separate Vault inference endpoint (for example, locally hosted model)
# VAULT_BASE_URL=http://localhost:11434/v1
# VAULT_MODEL=your_local_model_name
# VAULT_API_KEY=ollama
