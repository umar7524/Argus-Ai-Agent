__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log

# Bundles and temporary files
*.zip
*.tmp
